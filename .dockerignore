# Build artifacts and local state
bin/
tmp/
web/dist/
# Strip the built SPA (prod rebuilds it; dev serves via Vite) but keep the
# placeholder so the dev image's `//go:embed all:dist` still compiles.
internal/webui/dist/*
!internal/webui/dist/.gitkeep
**/node_modules/

# Heavy native app workspaces not needed for the server image
mobile/
macos/
desktop/

# Local data and tooling
vault/
.git/
.github/
.idea/
.vscode/
.cursor/
.serena/
.superpowers/
.expo/
*.log
