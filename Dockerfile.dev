# syntax=docker/dockerfile:1
#
# Dev image for the Go server with `air` hot-reload. Source is baked in so the
# container starts populated; `docker compose watch` then syncs host edits into
# /src and air rebuilds the binary (.air.toml, :8090). go.mod/go.sum changes
# trigger a full image rebuild (see docker-compose.dev.yml develop.watch).
FROM golang:1.25-alpine
RUN apk add --no-cache git ca-certificates
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
# Pre-fetch the pinned tools (air, templ) referenced in go.mod's tool block.
RUN go tool air -v >/dev/null 2>&1 || true
# Bake the source in for the initial run; watch keeps it fresh afterwards.
# The vault, node_modules and build artifacts are excluded via .dockerignore.
COPY . .
EXPOSE 8090
CMD ["go", "tool", "air"]
