{
  "name": "mindbase",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "mobile",
    "web"
  ],
  "scripts": {
    "mobile:prebuild": "bun run --cwd mobile prebuild",
    "mobile:prebuild:clean": "bun run --cwd mobile prebuild:clean",
    "mobile:start": "bun run --cwd mobile start",
    "mobile:ios": "bun run --cwd mobile ios",
    "mobile:android": "bun run --cwd mobile android",
    "web:build": "bun run --cwd web build",
    "web:dev": "bun run --cwd web dev"
  }
}
